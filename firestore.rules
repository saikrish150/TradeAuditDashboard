rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Initial Security Layer: Rule based on current date for test phase
    // In full production, we will transition to Firebase Auth UID checks
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 5, 15);
    }
  }
}
